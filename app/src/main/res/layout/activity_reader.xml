<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    tools:context=".ReaderActivity">

    <!-- 1. TOP BAR CỐ ĐỊNH Ở ĐỈNH -->
    <RelativeLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentTop="true"
        android:background="#FFFFFF"
        android:elevation="1dp"
        android:paddingHorizontal="16dp"
        android:paddingTop="32dp"
        android:paddingBottom="12dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Back"
            android:padding="8dp"
            app:srcCompat="@drawable/ic_arrow_back"
            app:tint="#111827" />

        <!-- Tiêu đề chính giữa -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chương 3"
                android:textColor="#111827"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Những ngày chậm rãi"
                android:textColor="#6B7280"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Cụm nút bên phải -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="32dp"
                android:layout_height="32dp"
                app:cardBackgroundColor="#F1F5F9"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_gravity="center"
                    android:contentDescription="Play"
                    android:src="@drawable/ic_play"
                    app:tint="#111827" />
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:layout_marginStart="8dp"
                app:cardBackgroundColor="#EFF6FF"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Aa"
                    android:textColor="#2563EB"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </RelativeLayout>

    <!-- 2. BOTTOM BAR CỐ ĐỊNH Ở ĐÁY -->
    <LinearLayout
        android:id="@+id/bottomBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingVertical="16dp">

        <!-- Hàng 1: Điều hướng -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/btnPrevPage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:contentDescription="Previous"
                android:src="@drawable/ic_chevron_left"
                app:tint="#2563EB" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="Trang 45/180 - 25%"
                android:textColor="#111827"
                android:textSize="11sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/btnNextPage"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:contentDescription="Next"
                android:src="@drawable/ic_chevron_right"
                app:tint="#2563EB" />
        </RelativeLayout>

        <!-- Hàng 2: SeekBar Tiến độ -->
        <SeekBar
            android:id="@+id/seekBarProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:progress="25"
            android:progressTint="#2563EB"
            android:thumbTint="#2563EB" />

        <!-- Hàng 3: Thời gian còn lại -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:text="Còn 6 phút trong chương"
            android:textColor="#9CA3AF"
            android:textSize="10sp" />
    </LinearLayout>

    <!-- 3. VÙNG VĂN BẢN CUỘN -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomBar"
        android:layout_below="@id/topBar"
        android:clipToPadding="false"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="24dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MÙA THU - 03"
                android:textColor="#9CA3AF"
                android:textSize="10sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="serif"
                android:text="Thư viện nửa đêm"
                android:textColor="#111827"
                android:textSize="26sp"
                android:textStyle="bold" />

            <!-- Nội dung truyện được dàn siêu dài -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:justificationMode="inter_word"
                android:lineSpacingExtra="10dp"
                android:text="Buổi chiều, gió trở về qua ngõ nhỏ, mang theo hương lá khô và hơi đất sau cơn mưa. Tôi ngồi bên cửa sổ, nhìn nắng chậm rãi trôi trên bậc thềm.\n\nCó những bình yên chỉ tìm thấy khi ta thôi vội vã.\n\nTôi khép cuốn sổ, lắng nghe tiếng gió đi qua hàng cây trước nhà. Ngày còn dài, nhưng lòng đã thôi không còn những muộn phiền dang dở. Giữa sự sống và cái chết có một thư viện, và trong thư viện ấy, các kệ sách cứ kéo dài vô tận. Mỗi cuốn sách cho bạn cơ hội thử một cuộc đời khác mà bạn đã sống.\n\nNora Seed đứng chôn chân giữa những hàng sách cao ngút ngàn. Không gian ngập tràn một thứ ánh sáng xanh dìu dịu, tựa như màu của rạng đông. Người thủ thư già, bà Elm, mỉm cười nhìn cô, ánh mắt hiền từ nhưng chứa đựng sự thông thái của hàng ngàn kiếp người.\n\n'Mỗi cuốn sách ở đây,' bà cất giọng trầm ấm, phá vỡ bầu không tĩnh lặng, 'là một phiên bản khác của cuộc đời cháu. Cuốn sách màu xanh lục lục kia là cháu nếu cháu không từ bỏ bơi lội. Cuốn màu đỏ ở góc kia là cháu nếu cháu đi đến Úc cùng Dan.'\n\nNora đưa tay chạm vào gáy một cuốn sách bìa da sờn cũ, cảm nhận được nhịp đập khe khẽ truyền qua những ngón tay. Liệu cô có thực sự muốn thay đổi? Liệu hạnh phúc có nằm ở một ngã rẽ khác mà cô đã vô tình bỏ lỡ? Những câu hỏi cứ xoáy sâu vào tâm trí, trong khi tiếng tích tắc của chiếc đồng hồ quả lắc ở góc phòng vang lên đều đặn, nhắc nhở rằng thời gian ở đây không tồn tại như cách cô vẫn biết.\n\nCô hít một hơi thật sâu, rút cuốn sách màu đỏ ra khỏi kệ. Ngay khoảnh khắc cuốn sách mở ra, toàn bộ thư viện xung quanh cô mờ dần, nhường chỗ cho một cơn lốc xoáy của ký ức và những khả năng vô tận..."
                android:textColor="#333333"
                android:textSize="16sp" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</RelativeLayout>
