<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/overlaySortModal"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#660F172A"
    android:clickable="true"
    android:focusable="true"
    tools:ignore="HardcodedText,ContentDescription,SmallSp,UseCompoundDrawables,DisableBaselineAlignment">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        app:cardBackgroundColor="#FFFFFF"
        app:cardCornerRadius="24dp"
        app:cardElevation="16dp"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- Hàng Tiêu đề -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <FrameLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="@drawable/bg_home_indicator"
                    android:backgroundTint="#EFF6FF">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:contentDescription="Sort Icon"
                        android:src="@drawable/ic_sort"
                        app:tint="#2563EB" />
                </FrameLayout>

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:layout_weight="1"
                    android:text="Sắp xếp sách"
                    android:textColor="#111827"
                    android:textSize="17sp"
                    android:textStyle="bold" />

                <ImageButton
                    android:id="@+id/btnCloseSort"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Close"
                    android:padding="6dp"
                    android:src="@drawable/ic_close"
                    app:tint="#9CA3AF" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Chọn thứ tự hiển thị trong thư viện."
                android:textColor="#6B7280"
                android:textSize="13sp" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="12dp"
                android:layout_marginBottom="12dp"
                android:background="#F1F5F9" />

            <!-- RadioGroup / Containers -->
            <LinearLayout
                android:id="@+id/rgSortOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical">

                <!-- Item 1: Mới nhất (Active) -->
                <LinearLayout
                    android:id="@+id/layoutNewest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_home_indicator"
                    android:backgroundTint="#EEF2FF"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <RadioButton
                        android:id="@+id/rbNewest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="true"
                        android:buttonTint="#2563EB"
                        android:text="Mới nhất"
                        android:textColor="#2563EB"
                        android:textSize="14sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <!-- Item 2: Cũ nhất -->
                <LinearLayout
                    android:id="@+id/layoutOldest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_home_indicator"
                    android:backgroundTint="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <RadioButton
                        android:id="@+id/rbOldest"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="false"
                        android:buttonTint="#2563EB"
                        android:text="Cũ nhất"
                        android:textColor="#1F2937"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Item 3: Tên sách (A-Z) -->
                <LinearLayout
                    android:id="@+id/layoutTitleAZ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_home_indicator"
                    android:backgroundTint="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <RadioButton
                        android:id="@+id/rbTitleAZ"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="false"
                        android:buttonTint="#2563EB"
                        android:text="Tên sách (A–Z)"
                        android:textColor="#1F2937"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Item 4: Tên tác giả (A-Z) -->
                <LinearLayout
                    android:id="@+id/layoutAuthorAZ"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_home_indicator"
                    android:backgroundTint="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <RadioButton
                        android:id="@+id/rbAuthorAZ"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="false"
                        android:buttonTint="#2563EB"
                        android:text="Tên tác giả (A–Z)"
                        android:textColor="#1F2937"
                        android:textSize="14sp" />
                </LinearLayout>

                <!-- Item 5: Đọc gần đây -->
                <LinearLayout
                    android:id="@+id/layoutRecentRead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:background="@drawable/bg_home_indicator"
                    android:backgroundTint="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="12dp"
                    android:paddingBottom="10dp">

                    <RadioButton
                        android:id="@+id/rbRecentRead"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:checked="false"
                        android:buttonTint="#2563EB"
                        android:text="Đọc gần đây"
                        android:textColor="#1F2937"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Nút Áp dụng -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnApplySort"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="16dp"
                android:text="Áp dụng"
                android:textAllCaps="false"
                android:textColor="#FFFFFF"
                android:textSize="15sp"
                android:textStyle="bold"
                app:backgroundTint="#2563EB"
                app:cornerRadius="24dp"
                app:elevation="0dp" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>
</FrameLayout>
