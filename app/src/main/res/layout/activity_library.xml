<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8FAFC"
    tools:ignore="HardcodedText,ContentDescription,SmallSp,UseCompoundDrawables,DisableBaselineAlignment"
    tools:context=".MainActivity">

    <!-- TẦNG 2 - BOTTOM NAVIGATION BAR CỐ ĐỊNH Ở ĐÁY -->
    <LinearLayout
        android:id="@+id/bottomNavContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:elevation="8dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Item 1: Trang chủ -->
            <LinearLayout
                android:id="@+id/navHome"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Home"
                    android:src="@drawable/ic_home"
                    app:tint="#64748B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Trang chủ"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>

            <!-- Item 2: Tủ sách (Active) -->
            <LinearLayout
                android:id="@+id/navLibrary"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Library"
                    android:src="@drawable/ic_library"
                    app:tint="#2563EB" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Tủ sách"
                    android:textColor="#2563EB"
                    android:textSize="11sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- Item 3: Cá nhân -->
            <LinearLayout
                android:id="@+id/navProfile"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="Profile"
                    android:src="@drawable/ic_person"
                    app:tint="#64748B" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Cá nhân"
                    android:textColor="#64748B"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Home Indicator Bar -->
        <View
            android:layout_width="134dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="6dp"
            android:background="#111827" />
    </LinearLayout>

    <!-- TẦNG NỘI DUNG VỚI COORDINATOR LAYOUT: TỰ ĐỘNG ẨN HEADER KHI CUỘN -->
    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/bottomNavContainer">

        <!-- APPBAR LAYOUT: CHỨA HEADER TỰ ẨN KHI VUỐT -->
        <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appBarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#F8FAFC"
            app:elevation="0dp">

            <LinearLayout
                android:id="@+id/topHeader"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="#F8FAFC"
                android:orientation="vertical"
                android:paddingStart="16dp"
                android:paddingTop="20dp"
                android:paddingEnd="16dp"
                android:paddingBottom="6dp"
                app:layout_scrollFlags="scroll|enterAlways|snap">

                <!-- Hàng 1: Tiêu đề & Nút công cụ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Thư viện sách"
                        android:textColor="#111827"
                        android:textSize="20sp"
                        android:textStyle="bold" />

                    <ImageButton
                        android:id="@+id/btnFilter"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:background="@drawable/bg_home_indicator"
                        android:backgroundTint="#EFF6FF"
                        android:contentDescription="Filter"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_filter" />

                    <ImageButton
                        android:id="@+id/btnSort"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:layout_marginStart="8dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="Sort"
                        android:padding="9dp"
                        android:scaleType="centerInside"
                        app:srcCompat="@drawable/ic_sort" />
                </LinearLayout>

                <!-- Hàng 2: Filter Chips dạng cuộn ngang nhỏ gọn tiết kiệm chiều cao -->
                <HorizontalScrollView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChipAll"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:minHeight="36dp"
                            android:paddingHorizontal="14dp"
                            android:text="Tất cả"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:backgroundTint="#2563EB"
                            app:cornerRadius="18dp"
                            app:elevation="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChipAudio"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:minHeight="36dp"
                            android:paddingHorizontal="14dp"
                            android:text="Sách nói (Audio)"
                            android:textAllCaps="false"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            app:cornerRadius="18dp"
                            app:strokeColor="#CBD5E1"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChipOffline"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:layout_marginEnd="6dp"
                            android:minHeight="36dp"
                            android:paddingHorizontal="14dp"
                            android:text="Đã tải về (Offline)"
                            android:textAllCaps="false"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            app:cornerRadius="18dp"
                            app:strokeColor="#CBD5E1"
                            app:strokeWidth="1dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnChipCommunity"
                            style="@style/Widget.Material3.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:minHeight="36dp"
                            android:paddingHorizontal="14dp"
                            android:text="Sách cộng đồng"
                            android:textAllCaps="false"
                            android:textColor="#64748B"
                            android:textSize="12sp"
                            app:cornerRadius="18dp"
                            app:strokeColor="#CBD5E1"
                            app:strokeWidth="1dp" />
                    </LinearLayout>
                </HorizontalScrollView>

                <!-- Ô tìm kiếm sách -->
                <EditText
                    android:id="@+id/etSearchBook"
                    android:layout_width="match_parent"
                    android:layout_height="42dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/bg_home_indicator"
                    android:backgroundTint="#EFF6FF"
                    android:drawableStart="@android:drawable/ic_menu_search"
                    android:drawablePadding="10dp"
                    android:hint="Tìm tên sách hoặc tác giả..."
                    android:inputType="text"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:singleLine="true"
                    android:textColor="#111827"
                    android:textColorHint="#94A3B8"
                    android:textSize="13sp" />

                <!-- Hàng 3: Sub-header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/txtBookCount"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="24 cuốn sách"
                        android:textColor="#111827"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/txtCurrentSort"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mới nhất"
                        android:textColor="#6B7280"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.appbar.AppBarLayout>

        <!-- DANH SÁCH SÁCH: TỰ ĐỘNG MỞ RỘNG KHI HEADER CUỘN ẨN -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerBooks"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingStart="8dp"
            android:paddingTop="6dp"
            android:paddingEnd="8dp"
            android:paddingBottom="70dp"
            android:scrollbars="vertical"
            app:layout_behavior="@string/appbar_scrolling_view_behavior" />

        <!-- NÚT CUỘN LÊN ĐẦU (^) Ở GÓC DƯỚI BÊN TRÁI -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScrollTop"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom|start"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="16dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:padding="0dp"
            app:backgroundTint="#2563EB"
            app:cornerRadius="22dp"
            app:elevation="8dp"
            app:icon="@drawable/ic_arrow_up"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:iconTint="#FFFFFF" />

        <!-- NÚT "ĐĂNG TẢI SÁCH (+)" NỔI Ở GÓC DƯỚI BÊN PHẢI -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUploadBook"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:layout_gravity="bottom|end"
            android:layout_marginEnd="16dp"
            android:layout_marginBottom="16dp"
            android:elevation="16dp"
            android:text="Đăng tải sách (+)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            app:backgroundTint="#2563EB"
            app:cornerRadius="22dp"
            app:elevation="8dp" />

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

</RelativeLayout>
